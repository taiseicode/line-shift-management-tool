# LINEの設定（LINE Developersで取得）
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN

# Flask
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000

# DBファイルパス（任意）
DB_PATH=shift.db

# PostgreSQL / Supabase. Leave empty to use SQLite DB_PATH.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Admin page timing logs. Production recommendation: keep this disabled.
# ADMIN_TIMING_LOG=1 prints admin route timings.
# ADMIN_TIMING_LOG=0 disables timing logs.
ADMIN_TIMING_LOG=0

# Optional secret for /internal/run-notifications.
# Set a long random value in production and call:
# /internal/run-notifications?secret=YOUR_LONG_RANDOM_SECRET
CRON_SECRET=
